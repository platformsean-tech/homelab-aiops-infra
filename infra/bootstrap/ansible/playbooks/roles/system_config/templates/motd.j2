#!/bin/bash
# /etc/update-motd.d/99-{{ motd_script_name }}
# {{ company_name }} {{ environment | capitalize }} Environment MOTD

# ANSI color codes
RED='\033[1;31m'
GREEN='\033[1;32m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
YELLOW='\033[1;33m'
MAGENTA='\033[1;35m'
RESET='\033[0m'

clear
echo -e "${BLUE}"
cat <<'EOF'

               _   _            _             
  ___ ___ _ __| |_| | ___   ___| | _____ _ __ 
 / __/ _ \ '__| __| |/ _ \ / __| |/ / _ \ '__|
| (_|  __/ |  | |_| | (_) | (__|   <  __/ |   
 \___\___|_|   \__|_|\___/ \___|_|\_\___|_|   

                                                         
                           .io
EOF
echo -e "${RESET}"

echo -e "${GREEN}🚀  {{ deploy_environment | default(environment) | capitalize }} Environment — {{ company_name }}${RESET}"
echo -e "${CYAN}{{ company_tagline }}${RESET}"
echo ""

echo -e "${YELLOW}💻  Hostname:${RESET} $(hostname)"
echo -e "${YELLOW}🌍  IP:${RESET} $(hostname -I | awk '{print $1}')"
echo -e "${YELLOW}📦  Uptime:${RESET} $(uptime -p)"
echo -e "${YELLOW}📅  Date:${RESET} $(date)"
echo ""

